generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id        String   @id @default("main")
  name      String   @default("Serava Retreats")
  tagline   String   @default("Your Private Island Escape")
  blurb     String   @default("Boutique studios, suites and a private villa near Eagle Beach, Aruba.")
  // Contact
  email     String   @default("info@seravaretreats.com")
  phone     String   @default("+297 000 0000")
  whatsapp  String   @default("https://wa.me/2970000000")
  area      String   @default("Eagle Beach Area, Aruba")
  // Socials
  instagram String   @default("")
  facebook  String   @default("")
  // Integrations
  mapsEmbed    String @default("")
  notifyEmail  String @default("")
  analyticsId  String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  filter      String
  units       Int
  maxGuests   Int
  short       String
  description String
  bedrooms    String   @default("To be confirmed")
  bathrooms   String   @default("To be confirmed")
  photo       String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  unitRecords Unit[]
  categoryAmenities CategoryAmenity[]
}

model CategoryAmenity {
  id         String   @id @default(cuid())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  icon       String
  label      String
  order      Int      @default(0)
}

model Unit {
  id         String   @id
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String
  name       String
  maxGuests  Int
  status     UnitStatus @default(Active)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UnitStatus {
  Active
  Inactive
  Hidden
}

model Amenity {
  id    String @id @default(cuid())
  icon  String
  title String
  text  String
  order Int    @default(0)
}

model HouseRule {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model ExploreEntry {
  id    String @id @default(cuid())
  key   String @unique
  cat   String
  title String
  text  String
  order Int    @default(0)
}

model GalleryItem {
  id      String @id
  cat     String
  caption String
  altText String @default("")
  mediaId String @default("")
  order   Int    @default(0)
}

model PageContent {
  key   String @id
  data  Json
}

model SeoEntry {
  key         String @id
  route       String
  title       String
  description String
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(Staff)
  status    UserStatus @default(Invited)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  Owner
  Manager
  Staff
}

enum UserStatus {
  Active
  Invited
  Suspended
}
