# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=replace_with_a_random_32_byte_hex_string

# Full public URL of the site. Required in development; not needed on Vercel.
NEXTAUTH_URL=http://localhost:3000

# Initial owner account (dev fallback when no database is configured)
SEED_OWNER_EMAIL=owner@seravaretreats.com
SEED_OWNER_PASSWORD=change_me_in_production
SEED_OWNER_NAME=Property Owner

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The site runs from seed data without this.
# DATABASE_URL=postgresql://serava:serava@localhost:5432/serava

# ── Email delivery ────────────────────────────────────────────────────────────
# Option A: Resend (recommended — https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# NOTIFY_EMAIL=owner@seravaretreats.com

# Option B: SMTP (requires `nodemailer` in dependencies — see lib/email.ts)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# SMTP_FROM=noreply@seravaretreats.com

# ── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
